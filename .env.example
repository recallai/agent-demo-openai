# Same Recall workspace where you save the OpenAI key in Dashboard > Agents.
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1
RECALL_API_KEY=

# Use the same OpenAI project/key as the Recall dashboard integration.
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=low

# Seconds to wait for admission/provider startup, then maximum connected duration.
CONNECT_TIMEOUT_SECONDS=300
SESSION_TIMEOUT_SECONDS=600
LAUNCHER_PORT=8003
